{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "web",
        "run",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "fake-api",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "tools/fake-api.py"
      ],
      "port": 8080
    },
    {
      "name": "fake-api-2027",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "tools/fake-api.py",
        "data/2027-kalendar.json"
      ],
      "port": 8080
    },
    {
      "name": "web-prihlaseny",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "cd web && API_URL=http://localhost:8099 IDENTITA_AUTHORITY=http://localhost:9999 IDENTITA_CLIENT_ID=zkouska WEB_URL=http://localhost:3099 npx next dev -p 3099"
      ],
      "port": 3099
    }
  ]
}
