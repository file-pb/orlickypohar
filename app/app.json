{
  "expo": {
    "name": "Orlický pohár",
    "slug": "orlickypohar",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "orlickypohar",
    "userInterfaceStyle": "automatic",
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FCFCFB",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "cz.klihovka.orlickypohar",
      "permissions": [
        "android.permission.ACCESS_NOTIFICATION_POLICY"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FCFCFB",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 150
        }
      ],
      "expo-secure-store",
      "expo-web-browser",
      "expo-sharing",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Poloha slouží k záznamu trasy lodi během závodu.",
          "locationAlwaysAndWhenInUsePermission": "Trasa se zaznamenává celý závod, i když je telefon zamčený v kapse. Bez oprávnění „Vždy\" by záznam skončil, jak zhasne displej.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "enableSceneSupport": true
          }
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/android-icon-monochrome.png",
          "color": "#FCFCFB"
        }
      ],
      [
        "expo-audio",
        {
          "recordAudioAndroid": false,
          "microphonePermission": false,
          "enableBackgroundPlayback": true,
          "enableBackgroundRecording": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "description": "Výsledky a průběžné pořadí seriálu závodů plachetnic na Orlíku.",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "247c0516-53e2-4457-bcbd-dc7b1cd6025a"
      }
    },
    "owner": "file75",
    "ios": {
      "bundleIdentifier": "cz.klihovka.orlickypohar",
      "supportsTablet": true
    },
    "updates": {
      "url": "https://u.expo.dev/247c0516-53e2-4457-bcbd-dc7b1cd6025a",
      "fallbackToCacheTimeout": 5000
    },
    "runtimeVersion": {
      "policy": "fingerprint"
    }
  }
}
