{
  "expo": {
    "name": "Orlický pohár",
    "slug": "orlickypohar",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "orlickypohar",
    "userInterfaceStyle": "automatic",
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FCFCFB",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "cz.klihovka.orlickypohar"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FCFCFB",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 150
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "description": "Výsledky a průběžné pořadí seriálu závodů plachetnic na Orlíku.",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "247c0516-53e2-4457-bcbd-dc7b1cd6025a"
      }
    },
    "owner": "file75"
  }
}
