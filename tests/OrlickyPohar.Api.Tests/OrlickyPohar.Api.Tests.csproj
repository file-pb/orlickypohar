    <Content Include="..\..\data\2026-poradi-rozhodci.json" Link="Data\2026-poradi-rozhodci.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\data\2026-fxck-cancer.json" Link="Data\2026-fxck-cancer.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- Snímek RSS Českého svazu jachtingu: ověřuje rozbor proti skutečnému tvaru. -->
